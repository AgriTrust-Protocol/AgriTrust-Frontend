{
  "title": "AgriTrust Frontend SLOs",
  "tags": [
    "agritrust",
    "istio",
    "slo"
  ],
  "timezone": "utc",
  "panels": [
    {
      "title": "Request rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(istio_requests_total{destination_service_name=\"agritrust-frontend\"}[5m]))"
        }
      ]
    },
    {
      "title": "Availability burn rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "agritrust_frontend:burn_rate:5m"
        },
        {
          "expr": "agritrust_frontend:burn_rate:30m"
        },
        {
          "expr": "agritrust_frontend:burn_rate:1h"
        },
        {
          "expr": "agritrust_frontend:burn_rate:2h"
        },
        {
          "expr": "agritrust_frontend:burn_rate:6h"
        },
        {
          "expr": "agritrust_frontend:burn_rate:1d"
        }
      ]
    },
    {
      "title": "P99 latency vs 100ms SLO",
      "type": "timeseries",
      "targets": [
        {
          "expr": "agritrust_frontend:p99_latency_ms:5m"
        },
        {
          "expr": "100"
        }
      ]
    },
    {
      "title": "5xx ratio",
      "type": "timeseries",
      "targets": [
        {
          "expr": "agritrust_frontend:request_error_ratio:5m"
        }
      ]
    },
    {
      "title": "Stable/canary ready pods",
      "type": "timeseries",
      "targets": [
        {
          "expr": "kube_deployment_status_replicas_available{namespace=\"agritrust\",deployment=~\"agritrust-frontend-(stable|canary)\"}"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "version": 2
}
