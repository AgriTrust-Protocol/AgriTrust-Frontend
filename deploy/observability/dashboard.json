{
  "title": "AgriTrust Frontend Service Mesh",
  "tags": [
    "agritrust",
    "istio",
    "slo"
  ],
  "timezone": "utc",
  "panels": [
    {
      "title": "Request rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(istio_requests_total{destination_service_name='agritrust-frontend'}[5m]))"
        }
      ]
    },
    {
      "title": "P99 latency (ms)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(istio_request_duration_milliseconds_bucket{destination_service_name='agritrust-frontend'}[5m])))"
        }
      ]
    },
    {
      "title": "5xx ratio",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(istio_requests_total{destination_service_name='agritrust-frontend',response_code=~'5..'}[5m])) / clamp_min(sum(rate(istio_requests_total{destination_service_name='agritrust-frontend'}[5m])), 1)"
        }
      ]
    },
    {
      "title": "Dead letter queue stores",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (source, reason) (rate(dead_letter_message_stored[5m]))"
        }
      ]
    },
    {
      "title": "Webhook dead-lettered deliveries",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (reason, type) (rate(webhook_delivery_dead_lettered[5m]))"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "version": 2
}
