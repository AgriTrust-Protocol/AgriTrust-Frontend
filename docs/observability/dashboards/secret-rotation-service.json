{
  "title": "Secret Rotation Service",
  "schemaVersion": 39,
  "panels": [
    { "type": "stat", "title": "Successful rotations", "targets": [{ "expr": "sum(increase(secret_rotation_success_total[24h]))" }] },
    { "type": "stat", "title": "Failed rotations", "targets": [{ "expr": "sum(increase(secret_rotation_failure_total[24h]))" }] },
    { "type": "timeseries", "title": "P99 latency during rotation", "targets": [{ "expr": "max by (service, secret_kind) (secret_rotation_p99_latency_ms)" }] },
    { "type": "timeseries", "title": "Rotation error rate", "targets": [{ "expr": "max by (service, secret_kind) (secret_rotation_error_rate)" }] }
  ]
}
